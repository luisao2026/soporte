# Copie este archivo como .env en la carpeta del proyecto en el servidor:  cp deploy/env.docker.example .env
DEBUG=False
SECRET_KEY=PEGUE_AQUI_UNA_CLAVE_LARGA_Y_ALEATORIA
ALLOWED_HOSTS=soporte.istam.edu.ec,localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=https://soporte.istam.edu.ec
USAR_HTTPS=True

# Puerto interno donde escucha el sistema (Apache lo publica). Cámbielo si 8082 ya está ocupado.
PUERTO=8082

DB_NAME=soporte_istam
DB_USER=soporte
DB_PASSWORD=CAMBIE_ESTA_CONTRASEÑA

EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST_USER=soporte@istam.edu.ec
EMAIL_HOST_PASSWORD=contraseña_de_aplicacion

INSTITUCION_NOMBRE=INSTITUTO SUPERIOR TECNOLÓGICO AMAZÓNICO
INSTITUCION_SIGLAS=ISTAM
INSTITUCION_CIUDAD=Yantzaza
ROLES_REPORTES=ADMIN,PRACTICANTE
