# Copie este archivo como .env y ajuste los valores
SECRET_KEY=cambie-esta-clave
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Base de datos: deje vacío para SQLite, o use mysql (pip install mysqlclient) o postgres (pip install "psycopg[binary]")
DB_ENGINE=
DB_NAME=soporte_istam
DB_USER=root
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306

# Correo (sin esto, los avisos se muestran en la terminal)
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST_USER=sucorreo@gmail.com
# EMAIL_HOST_PASSWORD=contraseña_de_aplicacion_de_google

INSTITUCION_NOMBRE=INSTITUTO SUPERIOR TECNOLÓGICO AMAZÓNICO
INSTITUCION_SIGLAS=ISTAM
INSTITUCION_CIUDAD=Yantzaza

# Roles que ven los reportes (según el documento: ADMIN y PRACTICANTE). Agregue TIC si el Responsable de TIC también debe verlos.
ROLES_REPORTES=ADMIN,PRACTICANTE
